{
  "repetitions": 10,
  "shared_env": {
    "AMQP_URL": "amqp://guest:guest@localhost:5672/",
    "MAX_RETRIES": "3",
    "BASE_BACKOFF": "100ms",
    "MAX_BACKOFF": "6s",
    "HTTP_TIMEOUT": "6s",
    "PRODUCER_RATE": "100",
    "PRODUCER_POISSON": "true",
    "APISIM_LATENCY_MEAN": "10ms",
    "APISIM_LATENCY_JITTER": "4ms",
    "APISIM_ERROR_RATE": "0.5"
  },
  "rounds": [
    {
      "name": "exponential_b50_outage",
      "consumer_env": {
        "BACKOFF_STRATEGY": "exponential"
      },
      "apisim_env": {
        "APISIM_PATTERN": "outage",
        "APISIM_HEALTHY_WINDOW": "2s",
        "APISIM_OUTAGE_WINDOW": "2s"
      }
    },
    {
      "name": "exponential_b50_uniform",
      "consumer_env": {
        "BACKOFF_STRATEGY": "exponential"
      },
      "apisim_env": {
        "APISIM_PATTERN": "uniform"
      }
    },
    {
      "name": "none_b50_outage",
      "consumer_env": {
        "BACKOFF_STRATEGY": "none"
      },
      "apisim_env": {
        "APISIM_PATTERN": "outage",
        "APISIM_HEALTHY_WINDOW": "2s",
        "APISIM_OUTAGE_WINDOW": "2s"
      }
    },
    {
      "name": "none_b50_uniform",
      "consumer_env": {
        "BACKOFF_STRATEGY": "none"
      },
      "apisim_env": {
        "APISIM_PATTERN": "uniform"
      }
    }
  ]
}
